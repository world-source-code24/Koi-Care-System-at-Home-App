<Window x:Class="KoiCareSystemAtHome_App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KoiCareSystemAtHome_App"
        mc:Ignorable="d"
        Title="LoginWindow" Height="720" Width="1080">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="D:\Source\Repos\Koi-Care-System-at-Home-App\KoiCareSystemAtHome-App\KoiCareSystemAtHome-App\img\loginBackground.jpg"/>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label Foreground="White" Content="Login" FontSize="46" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="Bold" FontStyle="Italic"/>
        <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Column="0">
                <Label Content="Email:" FontSize="24" FontStyle="Italic" Foreground="White"/>
            </Grid>
            <Grid Grid.Column="1">
                <Border CornerRadius="10" BorderThickness="2" BorderBrush="#FF53CFD4" Margin="0,10,0,0">
                    <TextBox BorderThickness="0" Background="Transparent" Height="30" x:Name="txtEmail" Foreground="White"/>
                </Border>
            </Grid>
            <Grid Grid.Row="1">
                <Label Content="Password:" FontSize="24" FontStyle="Italic" Foreground="White"/>
            </Grid>
            <Grid Grid.Column="1" Grid.Row="1">
                <Border CornerRadius="10" BorderThickness="2" BorderBrush="#FF53CFD4" Margin="0,10,0,0">
                    <PasswordBox BorderThickness="0" Background="Transparent" Height="30" x:Name="txtPassword" Foreground="White"/>
                </Border>
            </Grid>
            <Button FontStyle="Italic" Grid.Column="1" Grid.Row="2" Content="Register" Background="Transparent" Foreground="White" BorderBrush="Transparent" HorizontalAlignment="Right"/>

        </Grid>
        <Border Grid.Column="1" CornerRadius="15" Background="White" HorizontalAlignment="Left" Margin="10,176,0,0" Grid.Row="1" VerticalAlignment="Top" Height="48" Width="120">
            <Button Click="btn_Login" Content="Login" Foreground="#FF53CFD4" FontSize="24" Background="Transparent" BorderThickness="0"/>
        </Border>
        <Border CornerRadius="15" Background="White" Grid.Column="1"  HorizontalAlignment="Left" Margin="230,176,0,0" Grid.Row="1" VerticalAlignment="Top" Height="48" Width="120">
            <Button Click="btn_Close" Content="Quit" Foreground="#FF53CFD4" FontSize="24" Background="Transparent" BorderThickness="0"/>
        </Border>
        
    </Grid>
</Window>
