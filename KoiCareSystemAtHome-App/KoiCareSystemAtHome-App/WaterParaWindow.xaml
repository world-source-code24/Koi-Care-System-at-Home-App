<Window x:Class="KoiCareSystemAtHome_App.WaterParaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
    xmlns:local="clr-namespace:KoiCareSystemAtHome_App"
    xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
    mc:Ignorable="d"

    Title="WaterManagement" Height="720"  Width="1080" WindowStartupLocation="CenterScreen" Background="Transparent" WindowStyle="None"
        AllowsTransparency="True" Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <DataTemplate x:Key="WaterParameterTemplate">
            <Border CornerRadius="20" 
                Height="240" 
                Width="190" 
                Background="WhiteSmoke" 
                Margin="10, 10, 10, 0" 
                BorderThickness="3" 
                BorderBrush="LightSlateGray">
                <Grid>
                    <!-- ID and Date Labels -->
                    <Label Content="{Binding ParameterId}" 
                       HorizontalAlignment="Left" 
                       Margin="10,10,0,0" 
                       VerticalAlignment="Top" 
                       FontWeight="Bold"/>
                    <Label Content="{Binding Date}" 
                       HorizontalAlignment="Left" 
                       Margin="10,36,0,0" 
                       VerticalAlignment="Top" 
                       FontWeight="Bold"/>

                    <!-- Temperature -->
                    <Label Content="{Binding Temperature, StringFormat={}{0}°C}" 
                       HorizontalAlignment="Left" 
                       Margin="111,10,0,0" 
                       VerticalAlignment="Top" 
                       FontWeight="Bold"/>

                    <!-- Left Column Information -->
                    <Label Content="Salt:" 
                       HorizontalAlignment="Left" 
                       Margin="10,70,0,0" 
                       VerticalAlignment="Top" 
                       FontWeight="Bold"/>
                    <Label Content="{Binding Salt}" 
                       HorizontalAlignment="Left" 
                       Margin="42,70,0,0" 
                       VerticalAlignment="Top"/>

                    <Label Content="pH:" 
                       HorizontalAlignment="Left" 
                       Margin="10,100,0,0" 
                       VerticalAlignment="Top" 
                       FontWeight="Bold"/>
                    <Label Content="{Binding PhLevel}" 
                       HorizontalAlignment="Left" 
                       Margin="31,100,0,0" 
                       VerticalAlignment="Top"/>

                    <Label Content="O₂:" 
                       HorizontalAlignment="Left" 
                       Margin="10,130,0,0" 
                       VerticalAlignment="Top" 
                       FontWeight="Bold"/>
                    <Label Content="{Binding O2Level}" 
                       HorizontalAlignment="Left" 
                       Margin="31,130,0,0" 
                       VerticalAlignment="Top"/>

                    <!-- Right Column Information -->
                    <Label Content="NO₂:" 
                       HorizontalAlignment="Left" 
                       Margin="85,70,0,0" 
                       VerticalAlignment="Top" 
                       FontWeight="Bold"/>
                    <Label Content="{Binding No2Level}" 
                       HorizontalAlignment="Left" 
                       Margin="115,70,0,0" 
                       VerticalAlignment="Top"/>

                    <Label Content="NO₃:" 
                       HorizontalAlignment="Left" 
                       Margin="85,100,0,0" 
                       VerticalAlignment="Top" 
                       FontWeight="Bold"/>
                    <Label Content="{Binding No3Level}" 
                       HorizontalAlignment="Left" 
                       Margin="117,100,0,0" 
                       VerticalAlignment="Top"/>

                    <Label Content="PO₄:" 
                       HorizontalAlignment="Left" 
                       Margin="85,130,0,0" 
                       VerticalAlignment="Top" 
                       FontWeight="Bold"/>
                    <Label Content="{Binding Po4Level}" 
                       HorizontalAlignment="Left" 
                       Margin="117,130,0,0" 
                       VerticalAlignment="Top"/>

                    <!-- Bottom Information -->
                    <Label Content="Chlorines:" 
                       HorizontalAlignment="Left" 
                       Margin="10,160,0,0" 
                       VerticalAlignment="Top" 
                       FontWeight="Bold"/>
                    <Label Content="{Binding TotalChlorines}" 
                       HorizontalAlignment="Left" 
                       Margin="80,160,0,0" 
                       VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="30" Background="#EFF2F7" MouseDown="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--Left Menu-->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!--Menu Icon-->
                <Button Style="{StaticResource topButton}" HorizontalAlignment="Left" Margin="20 28 0 35">
                    <Icon:PackIconMaterial Kind="Menu" Width="15" Height="15" />
                </Button>

                <Border Grid.Row="1" Background="#f05435" CornerRadius="0 50 0 30">
                    <DockPanel>
                        <!--Menu Logo-->
                        <Border Width="80" Height="80" Padding="3" Background="White" CornerRadius="100" DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="30 -30 0 0">
                            <Ellipse Margin="0,-3,-29,-3">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="/img/logo.png.jpg"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Border>

                        <!--Menu Titles-->
                        <TextBlock Text="Royal Koi" Foreground="White" FontSize="22" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="5 25 0 10" TextAlignment="Center"/>

                        <!--Menu Seprator-->
                        <Separator Margin="25" Background="#140907" DockPanel.Dock="Top" Height="0.8"/>

                        <!--Menu Buttons-->
                        <StackPanel DockPanel.Dock="Top" >
                            <Button Style="{StaticResource menuButton}" Click="Home_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="HomeVariant" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Home"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource menuButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="Account" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Profie"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource menuButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="ListBox" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Koi Management"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource menuButton}" Background="#db4b2e" Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="Monitor" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Water Paramester"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource menuButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="Monitor" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Pond List"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource menuButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="ChartBar" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Statistics"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>

                        <Button Style="{StaticResource menuButton}" VerticalAlignment="Bottom" DockPanel.Dock="Bottom" Margin="15 0 15 20" Click="Logout_Click">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="Logout" Style="{StaticResource menuButtonIcon}"/>
                                <TextBlock Text="Logout"/>
                            </StackPanel>
                        </Button>

                    </DockPanel>
                </Border>

            </Grid>

            <!--Main Section-->
            <Grid Grid.Column="1" Margin="30 20 20 20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="63*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="460*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <!--Top Buttons-->
                <Button Style="{StaticResource topButton}" Margin="0 0 20 0" Background="#dcdcdc">
                    <Icon:PackIconMaterial Kind="Cog"/>
                </Button>

                <Button Style="{StaticResource topButton}" Margin="0 0 55 0">
                    <Icon:PackIconMaterial Kind="Bell"/>
                </Button>

                <!--Page Title-->
                <TextBlock x:Name="txtHeader" Text="Water Management" Grid.Row="1" FontSize="32" FontWeight="SemiBold" Margin="0 20 0 0" Foreground="#121518" HorizontalAlignment="Left" Width="293"/>

                <!--Add Button-->
                <Button x:Name="btn_add1" Style="{StaticResource addButton}" Click="Button_Click" Margin="0,24,0,4" Grid.Row="1" Width="200">
                    <StackPanel Orientation="Horizontal">
                        <Icon:PackIconMaterial Kind="Plus" VerticalAlignment="Center" Margin="0 1 8 0" Width="11" Height="11"/>
                        <TextBlock Text="Add New Water Paramester"/>
                    </StackPanel>
                </Button>

                <!--Seprator-->
                <Separator Height="1" Grid.Row="3" Background="#DAE2EA" Margin="0 -1 0 10"/>

                <!--Tab buttons-->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 10 0 0">
                    <Button x:Name="btn_list" Style="{StaticResource tabButton}" Content="Water Paramester List |" BorderBrush="#db4b2e" Click="Button_Click" Width="153"/>
                    <Button x:Name="btn_detail" Style="{StaticResource tabButton}" Content="Water Paramester Detail |" Click="Button_Click" Width="170"/>
                </StackPanel>

                <!--Counter Title-->
                <TextBlock Text="List of Water Paramester: " Grid.Row="4" FontSize="18" FontWeight="SemiBold" Foreground="#121518" HorizontalAlignment="Left" VerticalAlignment="Center" Width="214"/>
                <TextBlock Text="Search:" Grid.Row="4" FontSize="13" FontWeight="SemiBold" Margin="0 0 215 0" Foreground="#121518" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                <!--Filter Textbox-->
                <Grid Width="200" HorizontalAlignment="Right" Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Margin="15 0" VerticalAlignment="Center" Foreground="#B0B9C6" IsHitTestVisible="False"
   Panel.ZIndex="1" Text="Search by Pond Name ..." 
   Visibility="{Binding ElementName=textBoxFilter, Path=Text.IsEmpty, Converter={StaticResource BoolToVis}}" />
                        <TextBox Name="textBoxFilter" Style="{StaticResource filterTextBox}" 
 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
 TextChanged="FilterTextChanged" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <!--Water Parameter List Gird -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="25,10,25,10">
                            <ItemsControl ItemsSource="{Binding WaterParameters}" ItemTemplate="{StaticResource WaterParameterTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>