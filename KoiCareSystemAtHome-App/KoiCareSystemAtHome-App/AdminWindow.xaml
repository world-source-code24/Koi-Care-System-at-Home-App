<Window x:Class="KoiCareSystemAtHome_App.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KoiCareSystemAtHome_App"
        mc:Ignorable="d"
        Title="Admin Window" Height="600" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- For the header -->
            <RowDefinition Height="*"/>
            <!-- For the rest of the content -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- Header Text -->
        <TextBlock Text="USER MANAGEMENT" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0" Grid.ColumnSpan="2" Margin="10, 10, 10, 20"/>

        <!-- User List -->
        <ListBox x:Name="UserList" Grid.Row="1" Grid.Column="0" Margin="10" SelectionChanged="UserList_SelectionChanged"/>

        <!-- User Details Form -->
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10" VerticalAlignment="Top">
            <TextBlock Text="User Name:" FontWeight="Bold"/>
            <TextBox x:Name="txtName" Margin="0,0,0,10"/>

            <TextBlock Text="Email:" FontWeight="Bold"/>
            <TextBox x:Name="txtEmail" Margin="0,0,0,10"/>

            <TextBlock Text="Phone:" FontWeight="Bold"/>
            <TextBox x:Name="txtPhone" Margin="0,0,0,10"/>

            <TextBlock Text="Address:" FontWeight="Bold"/>
            <TextBox x:Name="txtAddress" Margin="0,0,0,10"/>

            <TextBlock Text="Role:" FontWeight="Bold"/>
            <ComboBox x:Name="txtRoleID" Margin="0,0,0,10">
                <ComboBoxItem Tag="admin" Content="Admin" />
                <ComboBoxItem Tag="guest" Content="Guest" />
            </ComboBox>

            <TextBlock Text="Status (Active):" FontWeight="Bold"/>
            <CheckBox x:Name="txtStatus" Margin="0,0,0,20"/>

            <Button Content="Save" Click="SaveButton_Click" Width="100"/>
        </StackPanel>
    </Grid>
</Window>
