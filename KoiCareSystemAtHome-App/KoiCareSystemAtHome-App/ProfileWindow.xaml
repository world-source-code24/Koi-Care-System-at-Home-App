<Window x:Class="KoiCareSystemAtHome_App.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KoiCareSystemAtHome_App"
        mc:Ignorable="d"
        Title="ProfileWindow" Height="720" Width="1080">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="#FF53CFD4">
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Image/>
            <Button Background="#FF53CFD4" Foreground="White" FontWeight="Bold" FontSize="18" Grid.Row="1" Content="Profile"/>
            <Button Background="#FF53CFD4" Foreground="White" FontWeight="Bold" FontSize="18" Grid.Row="2" Content="Pond Management"/>
            <Button Background="#FF53CFD4" Foreground="White" FontWeight="Bold" FontSize="18" Grid.Row="3" Content="koi Management"/>
            <Button Background="#FF53CFD4" Foreground="White" FontWeight="Bold" FontSize="18" Grid.Row="4" Content="Water Parameter"/>
            <Button Background="#FF53CFD4" Foreground="White" FontWeight="Bold" FontSize="18" Grid.Row="6" Content="Logout"/>
        </Grid>
        <Grid Grid.Column="1" Background="#FF53CFD4">
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="1" Grid.Column="1">
                <Rectangle HorizontalAlignment="Left" Height="155" Margin="10,10,0,0" Stroke="Black" VerticalAlignment="Top" Width="155"/>
                <Image HorizontalAlignment="Left" Height="150" Margin="15,15,0,0" VerticalAlignment="Top" Width="150"/>
            </Grid>
            <Label FontSize="24" Grid.Column="1" Content="Role" HorizontalAlignment="Left" Margin="63,0,0,0" Grid.Row="1" VerticalAlignment="Center"/>
            <Label FontSize="24" Grid.Column="1" Content="Email:" HorizontalAlignment="Left" Margin="318,10,0,0" Grid.Row="1" VerticalAlignment="Top"/>
            <Label FontSize="24" Grid.Column="1" Content="Password:" HorizontalAlignment="Left" Margin="276,104,0,0" Grid.Row="1" VerticalAlignment="Top"/>
            <Label FontSize="24" Grid.Column="1" Content="Phone Number:" HorizontalAlignment="Left" Margin="219,57,0,0" Grid.Row="1" VerticalAlignment="Top"/>
            <Label FontSize="24" Grid.Column="1" Content="Address:" HorizontalAlignment="Left" Margin="290,151,0,0" Grid.Row="1" VerticalAlignment="Top"/>
            <TextBox Grid.Column="1" HorizontalAlignment="Left" Margin="400,10,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="300" Height="42"/>
            <TextBox Grid.Column="1" HorizontalAlignment="Left" Margin="400,57,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="300" Height="42"/>
            <PasswordBox Grid.Column="1" HorizontalAlignment="Left" Margin="400,104,0,0" Grid.Row="1" VerticalAlignment="Top" Width="300" Height="42"/>
            <TextBox Grid.Column="1" HorizontalAlignment="Left" Margin="400,151,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="300" Height="125"/>
            <TextBox BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Center" FontSize="24" HorizontalAlignment="Left" Margin="41,183,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="200" Height="39" Grid.ColumnSpan="2"/>
        </Grid>
    </Grid>
</Window>
